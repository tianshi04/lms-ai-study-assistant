# ====================================================================
# ENVIRONMENT CONFIGURATION FOR BACKEND & DOCKER INFRASTRUCTURE
# Instruction: Copy this file to .env in backend/ before running
# ====================================================================

# --------------------------------------------------------------------
# 1. DOCKER POSTGRESQL INFRASTRUCTURE (Used by docker-compose)
# --------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coursera_admin
POSTGRES_PASSWORD=coursera_password123
POSTGRES_DB=coursera_lms

# --------------------------------------------------------------------
# 2. DOCKER MINIO S3 INFRASTRUCTURE (Used by docker-compose)
# --------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password123

# --------------------------------------------------------------------
# 3. UNIFIED PYTHON APP CONFIGURATION (Parsed by Pydantic Settings)
# --------------------------------------------------------------------
ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Connection Strings & Credentials for Application Use
DATABASE_URL=postgresql://coursera_admin:coursera_password123@localhost:5432/coursera_lms
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password123
MINIO_BUCKET_NAME=coursera-assets
MINIO_SECURE=false

# --------------------------------------------------------------------
# 4. JWT AUTHENTICATION & TOKEN EXPIRATION
# --------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_coursera_2026_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------------------------
# 5. OPENTELEMETRY & JAEGER OBSERVABILITY
# --------------------------------------------------------------------
# OTLP Collector Endpoint for Distributed Tracing (e.g., Jaeger/OTel Collector)
# Uncomment the line below when running local Jaeger container:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317

# --------------------------------------------------------------------
# 6. VNPAY SANDBOX PAYMENT GATEWAY CONFIGURATION
# --------------------------------------------------------------------
VNPAY_TMN_CODE=PLM6WVVN
VNPAY_HASH_SECRET=MLQIAARTMNPRIGVBPAFCRFVCASOBHRTS
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
