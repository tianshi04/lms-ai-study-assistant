# ====================================================================
# LMS AI SYSTEM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# HƯỚNG DẪN: Copy file này thành .env trong thư mục backend/
# LƯU Ý: Dự án đã cấu hình sẵn giá trị mặc định cho Môi trường Dev Local.
#       Bạn có thể CHẠY NGAY mà KHÔNG CẦN XIN KEY ngoại trừ các API bên thứ 3.
# ====================================================================

# --------------------------------------------------------------------
# 1. KHÓA TÍCH HỢP BÊN THỨ 3 (THIRD-PARTY API KEYS)
# (Chỉ điền khi cần test đăng nhập Google hoặc Thanh toán VNPay)
# --------------------------------------------------------------------
# Google OAuth 2.0 (Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VNPay Sandbox Payment Gateway (Mã thử nghiệm Sandbox)
VNPAY_TMN_CODE=PLM6WVVN
VNPAY_HASH_SECRET=MLQIAARTMNPRIGVBPAFCRFVCASOBHRTS

# --------------------------------------------------------------------
# 2. CẤU HÌNH KẾT NỐI LOCAL INFRASTRUCTURE (ĐÃ CÓ DEFAULT ĐỂ CHẠY NGAY)
# (Chỉ thay đổi khi đổi Port hoặc Password Postgres/MinIO/Redis local)
# --------------------------------------------------------------------
ENV=development
DATABASE_URL=postgresql://coursera_admin:coursera_password123@localhost:5432/coursera_lms
REDIS_URL=redis://localhost:6379

# MinIO S3 Object Storage Credentials
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password123
MINIO_BUCKET_NAME=coursera-assets

# JWT Security Key (Đổi sang chuỗi bí mật ngẫu nhiên khi deploy Production)
JWT_SECRET=your_super_secret_jwt_key_coursera_2026_change_in_prod
