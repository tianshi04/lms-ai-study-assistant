# ====================================================================
# ENVIRONMENT CONFIGURATION FOR BACKEND & DOCKER INFRASTRUCTURE
# Instruction: Copy this file to .env in backend/ before running
# ====================================================================

# --------------------------------------------------------------------
# 1. DOCKER POSTGRESQL INFRASTRUCTURE (Used by docker-compose)
# --------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coursera_admin
POSTGRES_PASSWORD=coursera_password123
POSTGRES_DB=coursera_lms

# --------------------------------------------------------------------
# 2. DOCKER MINIO & REDIS INFRASTRUCTURE (Used by docker-compose)
# --------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password123
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------------------------------------------------------------
# 3. UNIFIED PYTHON APP CONFIGURATION (Parsed by Pydantic Settings)
# --------------------------------------------------------------------
# Not a security switch: no auth bypass exists in any environment. Set 'production' on deploys.
ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# FRONTEND_URL & CORS_ORIGINS form the allow-list for CORS and Google OAuth redirect_uri.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex pattern for allowed origins (leave empty for Model 1 Same-Domain / Reverse Proxy setups)
CORS_ORIGIN_REGEX=

# Connection Strings & Credentials for Application Use
DATABASE_URL=postgresql://coursera_admin:coursera_password123@localhost:5432/coursera_lms
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password123
MINIO_BUCKET_NAME=coursera-assets
MINIO_SECURE=false

# --------------------------------------------------------------------
# 4. JWT AUTHENTICATION & TOKEN EXPIRATION
# --------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_coursera_2026_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------------------------
# 5. OPENTELEMETRY & OPENOBSERVE OBSERVABILITY (Logs, Metrics, Traces)
# --------------------------------------------------------------------
# Uncomment the line below when running local OpenObserve container (`make infra`):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5081
ZO_ROOT_USER_EMAIL=admin@coursera.local
ZO_ROOT_USER_PASSWORD=openobserve_password123
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=default
OPENOBSERVE_HTTP_PORT=5080
OPENOBSERVE_GRPC_PORT=5081

# --------------------------------------------------------------------
# 6. VNPAY SANDBOX PAYMENT GATEWAY CONFIGURATION
# --------------------------------------------------------------------
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# --------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 CONFIGURATION
# --------------------------------------------------------------------
# Required: Google sign-in is rejected (fail-closed) when these are empty. There is no mock mode.
# Register '<frontend origin>/auth/google/callback' as an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
