# ====================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION FOR DOCKER STACK (VPS DEPLOYMENT)
# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your DOMAIN and credentials
# 3. Run: docker compose up -d
# ====================================================================

# --------------------------------------------------------------------
# 1. DOMAIN & NETWORKING (Caddy Reverse Proxy + Automatic SSL)
# --------------------------------------------------------------------
# Use 'localhost' for local testing, or your domain (e.g., lms.yourdomain.com) for production.
DOMAIN=localhost

# --------------------------------------------------------------------
# 2. POSTGRESQL (Database with pgvector)
# --------------------------------------------------------------------
POSTGRES_USER=coursera_admin
POSTGRES_PASSWORD=coursera_password123_change_in_production
POSTGRES_DB=coursera_lms
POSTGRES_PORT=5432

# --------------------------------------------------------------------
# 3. MINIO S3 OBJECT STORAGE
# --------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password123_change_in_production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO Public Endpoint (leave commented out to default to https://${DOMAIN})
# MINIO_PUBLIC_ENDPOINT=https://lms.yourdomain.com

# --------------------------------------------------------------------
# 4. REDIS & OPENOBSERVE (All-in-One Observability: Logs, Metrics, Traces, RUM)
# --------------------------------------------------------------------
REDIS_PORT=6379
OPENOBSERVE_HTTP_PORT=5080
ZO_ROOT_USER_EMAIL=admin@coursera.local
ZO_ROOT_USER_PASSWORD=openobserve_password123_change_in_production
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5081
# Frontend Browser RUM & Session Replay Token (copied from OpenObserve UI -> Ingestion -> RUM)
OPENOBSERVE_CLIENT_TOKEN=
OPENOBSERVE_APPLICATION_ID=lms-frontend
OPENOBSERVE_ORG=default

# --------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION
# --------------------------------------------------------------------
# Generate a strong 64-char key in Linux: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Google OAuth 2.0 (For Google One-Tap / Social Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --------------------------------------------------------------------
# 6. COPILOTKIT AI ASSISTANT
# --------------------------------------------------------------------
# Google Gemini API Key for CopilotKit LLM
GOOGLE_API_KEY=your_google_gemini_api_key
COPILOT_MODEL=google/gemini-3.5-flash-lite

# --------------------------------------------------------------------
# 7. VNPAY PAYMENT GATEWAY (Optional - For Course Purchases)
# --------------------------------------------------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# --------------------------------------------------------------------
# 8. (OPTIONAL) PRE-BUILT DOCKER IMAGES (When using GitHub Releases / GHCR)
# --------------------------------------------------------------------
# FRONTEND_IMAGE=ghcr.io/your-username/your-repo/frontend:latest
# BACKEND_IMAGE=ghcr.io/your-username/your-repo/backend:latest
