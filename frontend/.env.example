# Next.js Frontend Environment Variables Template
# Copy this file to '.env.local' for local development configuration.

# Backend ConnectRPC API URL (Public URL called from Browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Internal Backend URL for Server-to-Server / Docker Network calls (RSC / Server Actions)
# INTERNAL_API_URL=http://backend:8000

# Application Environment ('development' | 'production' | 'staging')
# In 'development', test helper cards & dev tools are enabled.
NEXT_PUBLIC_ENV=development

# CopilotKit LLM Provider API Key & Model Configuration
GOOGLE_API_KEY=your_google_gemini_api_key_here
NEXT_PUBLIC_COPILOT_MODEL=google/gemini-3.6-flash

# Google OAuth 2.0 (GIS SDK)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
