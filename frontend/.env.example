# Next.js Frontend Environment Variables Template
# Copy this file to '.env.local' for local development configuration.

# Backend ConnectRPC API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Environment ('development' | 'production' | 'staging')
# In 'development', test helper cards & dev tools are enabled.
NEXT_PUBLIC_ENV=development

# CopilotKit LLM Provider API Key (Required for BuiltInAgent google/gemini-3.6-flash)
GOOGLE_API_KEY=your_google_gemini_api_key_here
