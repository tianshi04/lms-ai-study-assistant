# Next.js Frontend Environment Variables Template
# Copy this file to '.env.local' for local development configuration.

# Internal Backend URL for Server-to-Server / Docker Network calls (RSC / Server Actions / BFF Proxy)
# Defaults to http://127.0.0.1:8000 in local dev; set to http://backend:8000 inside Docker Compose.
INTERNAL_API_URL=http://127.0.0.1:8000

# Application Environment ('development' | 'production' | 'staging')
# In 'development', test helper cards & dev tools are enabled.
NEXT_PUBLIC_ENV=development

# CopilotKit LLM Provider API Key & Model Configuration (Server Runtime)
GOOGLE_API_KEY=your_google_gemini_api_key_here
COPILOT_MODEL=google/gemini-3.5-flash-lite

# Google OAuth 2.0 Client ID (Server Runtime; resolved dynamically via Server Action)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# OpenObserve Browser RUM, Logs & Session Replay (Server Runtime; optional)
# Copy Client Token from OpenObserve Web UI (http://localhost:5080 -> Ingestion -> Real User Monitoring)
OPENOBSERVE_CLIENT_TOKEN=
OPENOBSERVE_APPLICATION_ID=lms-frontend
OPENOBSERVE_SITE=
OPENOBSERVE_ORG=default
