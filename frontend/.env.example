# ====================================================================
# LMS AI SYSTEM - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# HƯỚNG DẪN: Copy file này thành .env.local trong thư mục frontend/
# ====================================================================

# 1. Backend ConnectRPC API URL (Mặc định chạy local: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Môi trường ứng dụng ('development' | 'production')
NEXT_PUBLIC_ENV=development

# 3. Trợ lý AI CopilotKit (Chỉ điền Gemini API Key khi cần test AI Assistant)
GOOGLE_API_KEY=your_google_gemini_api_key_here
NEXT_PUBLIC_COPILOT_MODEL=google/gemini-3.6-flash
